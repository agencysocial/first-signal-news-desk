# Phase 1a (bare feed checkpoint): SQLite by default, zero setup required.
# Swap DATABASE_URL to a Postgres/Supabase URL later -- the SQLAlchemy models
# don't change, only the connection string does.
DATABASE_URL=sqlite:///./aim_news_desk.db

APP_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Polling tiers, in minutes (Phase 1 default from spec)
POLL_MINUTES_PRIORITY=3
POLL_MINUTES_STANDARD=10
POLL_MINUTES_LOW=30

# Supabase (Phase 2: Postgres + team login). Get these from the Supabase
# dashboard -> Project Settings -> API / Database.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the login session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
